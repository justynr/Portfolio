{
  "name": "justynr",
  "version": "1.0.0",
  "description": "Justyn Roy's Portfolio",
  "main": "index.js",
  "author": "Justyn Roy",
  "repository": {
    "type": "git",
    "url": "git://github.com/justynr/portfolio",
    "private": true
  },
  "license": "MIT",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "classnames": "2.2.6",
    "date-fns": "2.14.0",
    "dotenv": "^8.2.0",
    "next": "^14.2.35",
    "nprogress": "^0.2.0",
    "react": "^18.3.1",
    "react-datocms": "^5.0.3",
    "react-dom": "^18.3.1",
    "react-icons": "^4.2.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "styled-components": "^5.3.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.9",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-wesbos": "^4.0.0",
    "eslint-plugin-html": "^8.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.49",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^10.1.4",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17"
  },
  "eslintConfig": {
    "parser": "@babel/eslint-parser",
    "extends": [
      "wesbos"
    ],
    "parserOptions": {
      "requireConfigFile": false,
      "babelOptions": {
        "presets": [
          "next/babel"
        ]
      }
    }
  },
  "//": "This is our babel config, I prefer this over a .babelrc file",
  "babel": {
    "env": {
      "development": {
        "presets": [
          "next/babel"
        ],
        "plugins": [
          [
            "styled-components",
            {
              "ssr": true,
              "displayName": true
            }
          ]
        ]
      },
      "production": {
        "presets": [
          "next/babel"
        ],
        "plugins": [
          [
            "styled-components",
            {
              "ssr": true,
              "displayName": true
            }
          ]
        ]
      },
      "test": {
        "presets": [
          [
            "next/babel",
            {
              "preset-env": {
                "modules": "commonjs"
              }
            }
          ]
        ],
        "plugins": [
          [
            "styled-components",
            {
              "ssr": true,
              "displayName": true
            }
          ]
        ]
      }
    }
  }
}
